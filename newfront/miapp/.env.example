# Puerto del WebSocket (el host se toma de la URL del navegador).
# VITE_WS_PORT=5001
#
# Solo si necesitas forzar una URL completa (poco habitual):
# VITE_WS_URL=ws://192.168.1.10:5001
# Futuro despliegue HTTPS: sin URL explícita se usa wss://<host>/ws.
# El servidor de despliegue debe configurar ese proxy hacia el backend.
# Alternativa: VITE_WS_URL=wss://chat.ejemplo.com/ws
