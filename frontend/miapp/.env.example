# --- Local ---
# Puerto del WebSocket (el host se toma de la URL del navegador).
# VITE_WS_PORT=5001
#
# --- Producción (Vercel) ---
# Pon la URL pública del backend (Render). Debe ser wss:// (HTTPS).
# Ejemplo: VITE_WS_URL=wss://chat-backend.onrender.com
# VITE_WS_URL=
#
# Local con IP fija (poco habitual):
# VITE_WS_URL=ws://192.168.1.10:5001
